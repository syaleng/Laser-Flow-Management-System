# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
JWT_SIGNING_KEY=replace-with-an-independent-random-signing-key

# PostgreSQL
POSTGRES_DB=laserflow
POSTGRES_USER=laserflow
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://laserflow:change-me@db:5432/laserflow

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

